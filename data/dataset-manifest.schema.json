{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/DenisGeide/flux2dev-lora-pipeline-showcase/blob/main/data/dataset-manifest.schema.json",
  "title": "FLUX LoRA dataset manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "dataset_id",
    "version",
    "license",
    "rights",
    "items"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schema_version": {
      "const": "1.0"
    },
    "dataset_id": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "license": {
      "type": "string",
      "minLength": 1,
      "description": "SPDX identifier or a link to dataset-specific terms."
    },
    "rights": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "basis",
        "public_release_approved",
        "contains_personal_data"
      ],
      "properties": {
        "basis": {
          "type": "string",
          "minLength": 1
        },
        "public_release_approved": {
          "type": "boolean"
        },
        "contains_personal_data": {
          "type": "boolean"
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "caption_strategy": {
      "type": "string"
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "image",
          "caption",
          "split"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "image": {
            "type": "string",
            "minLength": 1
          },
          "caption": {
            "type": "string",
            "minLength": 1
          },
          "split": {
            "enum": [
              "train",
              "validation",
              "test"
            ]
          },
          "width": {
            "type": "integer",
            "minimum": 1
          },
          "height": {
            "type": "integer",
            "minimum": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-fA-F0-9]{64}$"
          },
          "source": {
            "type": "string"
          },
          "license": {
            "type": "string"
          }
        }
      }
    }
  }
}
